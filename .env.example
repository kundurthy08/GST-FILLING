# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PCIL_DATA_DIR: Optional override for protected local SQLite database & archive directory.
# Defaults to ./pcil_data outside the source and build directories.
PCIL_DATA_DIR=

# PCIL_ADMIN_PASSCODE: Optional environment override for initial administrator authentication.
PCIL_ADMIN_PASSCODE=
